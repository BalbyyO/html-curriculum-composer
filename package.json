{
  "name": "html-curriculum-composer",
  "version": "0.1.0-beta",
  "private": true,
  "description": "Offline-first multi-page interactive HTML training & curriculum composer with 3D hardware labs, SCORM export, and printable SOPs",
  "author": "Matheus Oliveira",
  "license": "MIT",
  "main": "dist/main/index.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build",
    "build:hardware3d": "node scripts/build-hardware3d.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "dev:renderer": "vite",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "dist:msi": "npm run build && electron-builder --win msi --config electron-builder.yml"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "jszip": "^3.10.2",
    "playwright-core": "^1.51.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
